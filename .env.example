# Database
DATABASE_URL=postgresql+psycopg2://scrape_ssc:scrape_ssc_secret@localhost:5432/scrape_ssc

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ssc-admin
MINIO_SECRET_KEY=ssc-secret-key
